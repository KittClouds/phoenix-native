[package]
name = "kammi-client"
version = "0.1.0"
edition = "2024"
rust-version = "1.85"

[dependencies]
reqwest = { version = "0.12", default-features = false, features = ["blocking", "json", "rustls-tls"] }
serde_json = "1"
memchr = "2"
hashbrown = "0.15"
bytes = "1"

[[bin]]
name = "kammi-client-smoke"
path = "src/bin/smoke.rs"

[workspace]

[profile.release]
opt-level = 3
lto = "thin"
codegen-units = 1
